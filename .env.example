# Copy to .env and fill in. .env is gitignored; never commit it.
# The front end has its own file later (web/.env.local) with only NEXT_PUBLIC_API_URL.

# --- LLM (Gemini, D13) ---
LLM_PROVIDER=gemini
# aistudio.google.com -> Get API key
LLM_API_KEY=

# --- Judge model (D40), OpenAI-compatible adapter; leave empty until the judge is chosen ---
JUDGE_PROVIDER=
JUDGE_BASE_URL=
JUDGE_API_KEY=

# --- Postgres on Neon (D54): console.neon.tech -> project -> Connect -> pooled connection string ---
DATABASE_URL=

# --- Supabase (D11, D54): Storage for figure images ---
# Project Settings -> Database -> Connection string (URI, session pooler); only the weekly keep-alive uses it
SUPABASE_DB_URL=
# Project Settings -> API
SUPABASE_URL=
# Ingestion only; never put this in the HF Space secrets
SUPABASE_SERVICE_KEY=
SUPABASE_ANON_KEY=

# --- Langfuse (D18): cloud.langfuse.com -> project -> Settings -> API keys ---
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# --- Rate limiting (guardrail 9): any long random string ---
IP_HASH_SALT=

# --- PaddleOCR hosted API (D15), optional ---
PADDLEOCR_API_KEY=
# The per-user endpoint shown next to the token on the AI Studio API page, if it lists one
PADDLEOCR_API_URL=
